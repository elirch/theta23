# Theta23 — Space Mission Readiness Radar
# Copy to .env.local for local development. Never commit real values.

# Supabase PostgreSQL connection string (server-side only).
# Use the "Transaction pooler" URI from Supabase → Project Settings → Database
# when deploying to Vercel. Without it the app serves the bundled demo dataset
# read-only (visitors can still explore scenarios in a browser-only sandbox).
DATABASE_URL=

# Optional: PEM text of the Supabase CA certificate. When set, the database TLS
# certificate is fully verified. When unset, the connection is encrypted but
# the certificate chain is not verified.
DATABASE_CA_CERT=

# Owner sign-in. Only the owner can persist edits, import CSV, or reset demo data.
# Choose a long random password; it is checked server-side only.
OWNER_PASSWORD=

# Secret used to sign the owner session cookie (32+ random characters).
# e.g. `openssl rand -hex 32`
SESSION_SECRET=
